{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "capabilities for the main and region windows",
  "windows": [
    "main",
    "region"
  ],
  "permissions": [
    "core:default",
    "notification:default",
    "global-shortcut:allow-register",
    "global-shortcut:allow-unregister",
    "dialog:allow-open",
    "core:window:allow-close"
  ]
}
